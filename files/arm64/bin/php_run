#!/system/bin/sh

# Module path
MODPATH=$(dirname "$0")/..

# Define folder structure
BIN_DIR="$MODPATH/bin"
ETC_DIR="$MODPATH/etc"
VAR_DIR="$MODPATH/var"
WWW_DIR="$VAR_DIR/www"
TMP_DIR="$VAR_DIR/tmp"
LOG_DIR="$VAR_DIR/log"

# Server configuration
wserv_ip="0.0.0.0"
wserv_port="80"

# Core file path
php_bin="$BIN_DIR/php"
php_ini_conf="$ETC_DIR/php.ini"
php_log_path="$LOG_DIR/php8.log"
php_pid_path="$TMP_DIR/php8.pid"
resolv_conf="$ETC_DIR/resolv.conf"

# Busybox path
if [ -f "/data/adb/magisk/busybox" ]; then
    BUSYBOX="/data/adb/magisk/busybox"
else
    BUSYBOX="busybox"
fi
SETUIDGID="$BUSYBOX setuidgid"

# Fungsi Fix DNS untuk Static Binary Linux di Android
# Android tidak punya /etc/resolv.conf standar, jadi kita buatkan dummy
setup_dns() {
    if [ ! -f "$resolv_conf" ]; then
        echo "nameserver 8.8.8.8" > "$resolv_conf"
        echo "nameserver 1.1.1.1" >> "$resolv_conf"
    fi
    
    # Mount bind file resolv.conf kita ke /etc/resolv.conf (hanya jika belum ter-mount)
    if ! mount | grep -q "/etc/resolv.conf"; then
        # Pastikan file target ada (buat kosong jika belum ada)
        touch /etc/resolv.conf 2>/dev/null
        mount -o bind "$resolv_conf" /etc/resolv.conf 2>/dev/null
    fi
}

# Check PID function
check_pid_running() {
    if [ -f "$php_pid_path" ]; then
        local pid=$(cat "$php_pid_path")
        if [ -d "/proc/$pid" ]; then
            local cmdline=$(cat /proc/$pid/cmdline 2>/dev/null)
            # Cek sederhana apakah itu proses php
            if echo "$cmdline" | grep -q "php"; then
                return 0
            fi
        fi
        rm -f "$php_pid_path"
    fi
    return 1
}

# Start server function
start_wserv() {
    # 1. Siapkan Folder
    mkdir -p $TMP_DIR
    mkdir -p $LOG_DIR
    
    # PENTING: Beri izin penuh ke folder TMP agar Session/Upload bisa ditulis
    chmod 777 $TMP_DIR
    chmod 777 $LOG_DIR
    
    # Bersihkan log lama
    rm -f ${php_log_path}

    # 2. Cek apakah sudah jalan
    if check_pid_running; then
        echo "[INFO] : PHP Server is already running (PID: $(cat $php_pid_path))." > ${php_log_path}
        exit 0
    fi

    # 3. Cek Binary
    if [ ! -f "${php_bin}" ]; then
        echo "[ERR] : PHP binary not found in ${php_bin}!" > ${php_log_path}
        exit 1
    fi
    
    # Pastikan binary executable
    chmod +x "$php_bin"

    # 4. Siapkan DNS
    setup_dns

    # 5. Bersihkan proses nyasar
    killall php > /dev/null 2>&1

    echo "[INFO] : Starting PHP 8.4 Server..." > ${php_log_path}
    
    # 6. Jalankan Server
    # Perubahan: 
    # - Hapus LD_LIBRARY_PATH (karena static build)
    # - Tambah TMPDIR (agar php tahu lokasi temp)
    # - Gunakan setuidgid 0:3005 (Root:Net_Raw) agar bisa bind port < 1024
    
    nohup $SETUIDGID 0:3005 env TMPDIR=$TMP_DIR \
        $php_bin -n -S $wserv_ip:$wserv_port -t $WWW_DIR -c $php_ini_conf \
        >> $php_log_path 2>&1 &

    # Simpan PID
    echo -n $! > ${php_pid_path}

    sleep 2

    # Verifikasi
    if check_pid_running; then
        echo "[INFO] : Server SUCCESSFULLY started (PID: $(cat $php_pid_path))." >> ${php_log_path}
        echo "[INFO] : Listen in http://${wserv_ip}:${wserv_port}" >> ${php_log_path}
        echo "[INFO] : Web root in ${WWW_DIR}" >> ${php_log_path}
    else
        echo "[ERR] : Server FAILED to start. Check log above." >> ${php_log_path}
        # Tampilkan error log terakhir ke terminal jika start manual
        tail -n 3 $php_log_path
    fi
}

# Stop server function
stop_wserver() {
    if [ -f "$php_pid_path" ]; then
        local pid=$(cat "$php_pid_path")
        kill -9 $pid > /dev/null 2>&1
        rm -f "$php_pid_path"
        echo "[INFO] : PHP server stopped."
        
        # Unmount resolv.conf jika perlu (opsional, biar rapi)
        umount /etc/resolv.conf 2>/dev/null
    else
        killall php > /dev/null 2>&1
        echo "[INFO] : Cleaned up PHP processes."
    fi
}

# Argument control
case "$1" in
    -s|start)
        start_wserv
        ;;
    -k|stop)
        stop_wserver
        ;;
    -r|restart)
        stop_wserver
        sleep 1
        start_wserv
        ;;
    *)
        echo "Usage: $0 [-s|start] [-k|stop] [-r|restart]"
        ;;
esac

exit 0
